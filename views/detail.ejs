<%- include('partials/navbar') %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
  
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-400 font-medium">
    <a href="/" class="hover:text-emerald-400">Beranda</a>
    <i class="fa-solid fa-chevron-right text-[9px] text-slate-600"></i>
    <a href="/produk" class="hover:text-emerald-400">Katalog Produk</a>
    <i class="fa-solid fa-chevron-right text-[9px] text-slate-600"></i>
    <span class="text-emerald-400 font-semibold truncate"><%= product.name %></span>
  </nav>

  <!-- Product Detail Card -->
  <article class="glass-card rounded-3xl overflow-hidden shadow-2xl p-6 sm:p-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      
      <!-- Product Image -->
      <div class="md:col-span-6 space-y-4">
        <div class="relative rounded-2xl overflow-hidden bg-slate-800 aspect-square border border-slate-700/60 shadow-lg">
          <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover">
          <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-slate-900/80 backdrop-blur-md text-xs font-semibold text-emerald-400 border border-slate-700">
            <%= product.category %>
          </span>
        </div>
      </div>

      <!-- Product Information -->
      <div class="md:col-span-6 space-y-6">
        
        <div>
          <span class="text-xs text-slate-500 font-bold uppercase tracking-wider block">ID Produk: #<%= product.id %></span>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mt-1"><%= product.name %></h1>
        </div>

        <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 flex items-center justify-between">
          <div>
            <span class="text-xs text-slate-400 block">Harga Pas</span>
            <span class="text-2xl sm:text-3xl font-extrabold text-emerald-400">Rp <%= product.price.toLocaleString('id-ID') %></span>
            <span class="text-xs text-slate-500 font-medium"> / <%= product.unit %></span>
          </div>

          <div class="text-right">
            <span class="text-xs text-slate-400 block">Ketersediaan</span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold <%= product.stock > 10 ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : product.stock > 0 ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'bg-red-500/10 text-red-400 border border-red-500/20' %>">
              <i class="fa-solid fa-circle text-[8px]"></i>
              <%= product.stock > 0 ? 'Stok ' + product.stock + ' ' + product.unit : 'Stok Habis' %>
            </span>
          </div>
        </div>

        <div class="space-y-2">
          <h2 class="text-xs font-bold text-slate-300 uppercase tracking-wider">Deskripsi & Catatan Produk</h2>
          <p class="text-slate-300 text-sm leading-relaxed bg-slate-900/40 p-4 rounded-xl border border-slate-800/80">
            <%= product.description || 'Tidak ada deskripsi khusus untuk produk ini. Kualitas sembako terjamin murni dan segar.' %>
          </p>
        </div>

        <!-- Action CTAs -->
        <div class="space-y-3 pt-2">
          <a 
            href="https://wa.me/6281234567890?text=Halo%20Ibu%20Aries,%20saya%20mau%20pesan%20<%= encodeURIComponent(product.name) %>%20(Rp%20<%= product.price %>)." 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full py-3.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-bold text-sm shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center gap-2"
          >
            <i class="fa-brands fa-whatsapp text-lg"></i> Pesan via WhatsApp Ibu Aries
          </a>

          <div class="grid grid-cols-2 gap-3">
            <a href="/tanya-ai" class="py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-semibold text-center transition-all flex items-center justify-center gap-1.5">
              <i class="fa-solid fa-robot text-teal-400"></i> Tanya Bot AI
            </a>
            <a href="/produk" class="py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-semibold text-center transition-all flex items-center justify-center gap-1.5">
              <i class="fa-solid fa-arrow-left"></i> Kembali ke Katalog
            </a>
          </div>
        </div>

      </div>

    </div>
  </article>

</div>

<%- include('partials/footer') %>
