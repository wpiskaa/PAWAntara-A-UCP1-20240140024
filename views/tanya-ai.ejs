<%- include('partials/navbar') %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-6">
  
  <!-- Header -->
  <div class="text-center space-y-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-400 text-xs font-semibold">
      <i class="fa-solid fa-bolt text-[10px]"></i> Asisten Virtual Toko Sembako Ariesta
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Tanya AI Sembako</h1>
    <p class="text-slate-400 text-sm max-w-xl mx-auto">Tanyakan info harga beras, ketersediaan minyak goreng, ongkir, jam operasional, atau metode pembayaran secara langsung.</p>
  </div>

  <!-- Main Chat Window Card -->
  <div class="glass-card rounded-3xl overflow-hidden shadow-2xl border border-slate-700/80 flex flex-col h-[580px]">
    
    <!-- Chat Header -->
    <div class="p-4 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="relative">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-emerald-500 to-teal-400 text-white font-bold flex items-center justify-center shadow">
            <i class="fa-solid fa-robot"></i>
          </div>
          <span class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-emerald-500 border-2 border-slate-900"></span>
        </div>
        <div>
          <h2 class="font-bold text-white text-sm">Bot AI Ariesta</h2>
          <span class="text-[11px] text-emerald-400 font-medium">Online • Merespon Instan</span>
        </div>
      </div>

      <span class="text-xs text-slate-500 hidden sm:inline"><i class="fa-solid fa-shield-halved mr-1 text-emerald-400"></i>Backend Simulated AI</span>
    </div>

    <!-- Messages Body Scroll Area -->
    <div id="chat-messages" class="flex-grow p-4 sm:p-6 overflow-y-auto space-y-4 bg-slate-950/40">
      
      <!-- Initial Welcome Message -->
      <div class="flex gap-3 fade-in">
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-emerald-500 to-teal-400 text-white font-bold text-xs flex items-center justify-center flex-shrink-0 shadow">
          AI
        </div>
        <div class="max-w-[80%] bg-slate-800 border border-slate-700 text-slate-100 p-3.5 rounded-2xl rounded-tl-none shadow-md space-y-2">
          <p class="text-sm leading-relaxed">
            Halo! Selamat datang di <strong>Toko Sembako Ariesta</strong>. Saya Asisten AI fiktif yang siap membantu menjawab pertanyaan seputar sembako, stok beras & minyak, ongkir pengiriman, atau jam buka toko.
          </p>
          <p class="text-xs text-emerald-400 font-medium">
            Apa yang ingin Anda tanyakan hari ini? Silakan ketik atau pilih pertanyaan cepat di bawah ini.
          </p>
        </div>
      </div>

      <!-- Typing Indicator Placeholder -->
      <div id="typing-indicator" class="hidden flex gap-3 fade-in">
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-emerald-500 to-teal-400 text-white font-bold text-xs flex items-center justify-center flex-shrink-0 shadow">
          AI
        </div>
        <div class="bg-slate-800 border border-slate-700 p-3 rounded-2xl rounded-tl-none flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-bounce"></span>
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-bounce delay-150"></span>
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-bounce delay-300"></span>
        </div>
      </div>

    </div>

    <!-- Quick Suggestions Bar -->
    <div class="px-4 py-2 bg-slate-900/60 border-t border-slate-800/80 overflow-x-auto flex items-center gap-2 text-xs scrollbar-none">
      <span class="text-slate-500 font-medium whitespace-nowrap"><i class="fa-solid fa-lightbulb text-amber-400 mr-1"></i>Saran:</span>
      <button type="button" class="suggestion-btn px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 whitespace-nowrap transition-colors">
        "Jam berapa toko buka?"
      </button>
      <button type="button" class="suggestion-btn px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 whitespace-nowrap transition-colors">
        "Berapa harga beras 5kg?"
      </button>
      <button type="button" class="suggestion-btn px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 whitespace-nowrap transition-colors">
        "Ada pengiriman ke rumah?"
      </button>
      <button type="button" class="suggestion-btn px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 whitespace-nowrap transition-colors">
        "Bisa bayar pakai QRIS?"
      </button>
    </div>

    <!-- Chat Accessible Form -->
    <div class="p-4 bg-slate-900 border-t border-slate-800">
      <form id="chat-form" class="flex items-center gap-2">
        <label for="chat-input" class="sr-only">Tulis pertanyaan Anda untuk AI</label>
        <input 
          type="text" 
          id="chat-input" 
          name="question" 
          placeholder="Ketik pertanyaan seputar sembako, stok, atau ongkir..." 
          required
          aria-label="Pertanyaan untuk AI"
          class="flex-grow px-4 py-3 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all"
        >
        <button 
          type="submit" 
          aria-label="Kirim Pertanyaan"
          class="px-5 py-3 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-bold text-sm shadow-md shadow-emerald-600/20 transition-all flex items-center gap-2 flex-shrink-0"
        >
          <span>Kirim</span>
          <i class="fa-solid fa-paper-plane text-xs"></i>
        </button>
      </form>
    </div>

  </div>

</div>

<!-- Include Client-Side Chat JavaScript -->
<script src="/js/chat.js"></script>

<%- include('partials/footer') %>
