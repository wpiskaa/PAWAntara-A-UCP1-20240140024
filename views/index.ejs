<%- include('partials/navbar') %>

<!-- Hero Section -->
<section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28">
  <!-- Background Glow Accents -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-72 h-72 bg-teal-500/10 rounded-full blur-2xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text Content -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold tracking-wide">
          <i class="fa-solid fa-circle-check text-[10px]"></i> UMKM Sembako Ariesta — Harga Murah Terjamin
        </div>
        
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight">
          Belanja Sembako Lengkap, <span class="bg-gradient-to-r from-emerald-400 to-teal-300 bg-clip-text text-transparent">Tanya AI Langsung Jawab!</span>
        </h1>

        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Pesan beras premium, minyak goreng, gula, telur, dan bumbu dapur langsung dari Toko Ibu Aries. Cek stok real-time & harga terbaru tanpa antre.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a href="/produk" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-bold text-sm shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center gap-2 group">
            <i class="fa-solid fa-store"></i> Lihat Katalog Produk
            <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
          </a>

          <a href="/tanya-ai" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-100 font-bold text-sm transition-all flex items-center justify-center gap-2">
            <i class="fa-solid fa-robot text-teal-400"></i> Tanya Asisten AI
          </a>
        </div>

        <!-- Metric Badges -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-slate-800/80 max-w-lg mx-auto lg:mx-0">
          <div>
            <span class="block text-2xl font-extrabold text-white">100+</span>
            <span class="text-xs text-slate-400">Item Sembako</span>
          </div>
          <div>
            <span class="block text-2xl font-extrabold text-emerald-400">07:00</span>
            <span class="text-xs text-slate-400">Buka Tiap Hari</span>
          </div>
          <div>
            <span class="block text-2xl font-extrabold text-teal-300">Fast</span>
            <span class="text-xs text-slate-400">Antar Rumah</span>
          </div>
        </div>

      </div>

      <!-- Hero Banner Image / Preview Card -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <div class="glass-card p-4 sm:p-6 rounded-3xl glow-emerald shadow-2xl space-y-4">
            
            <div class="relative rounded-2xl overflow-hidden aspect-video bg-slate-800">
              <img src="https://images.unsplash.com/photo-1578916171728-46686eac8d58?auto=format&fit=crop&w=800&q=80" alt="Toko Sembako Ariesta" class="w-full h-full object-cover">
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
              <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-xs">
                <span class="px-2.5 py-1 rounded-md bg-emerald-500/80 backdrop-blur-md text-white font-semibold">Toko Buka</span>
                <span class="px-2.5 py-1 rounded-md bg-slate-900/80 backdrop-blur-md text-slate-200"><i class="fa-solid fa-location-dot text-emerald-400 mr-1"></i>Umbulharjo</span>
              </div>
            </div>

            <div class="p-2 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">Produk Terlaris</span>
                <span class="text-xs text-slate-400"><i class="fa-solid fa-star text-amber-400 mr-1"></i>4.9 (500+ pembeli)</span>
              </div>
              <h3 class="text-base font-bold text-white">Beras Premium Raja Udang 5kg</h3>
              <div class="flex items-center justify-between pt-1">
                <span class="text-lg font-extrabold text-emerald-400">Rp 72.000</span>
                <a href="/produk/1" class="px-3 py-1.5 rounded-lg bg-emerald-600/20 border border-emerald-500/30 text-emerald-400 text-xs font-semibold hover:bg-emerald-600 hover:text-white transition-colors">
                  Detail <i class="fa-solid fa-chevron-right ml-1 text-[10px]"></i>
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Featured Products Section -->
<section class="py-12 bg-slate-950/60 border-y border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Katalog Produk Pilihan</h2>
        <p class="text-slate-400 text-sm mt-1">Stok dan harga sembako selalu diperbarui langsung oleh Ibu Aries</p>
      </div>
      <a href="/produk" class="text-sm font-semibold text-emerald-400 hover:text-emerald-300 flex items-center gap-1 group">
        Lihat Semua Produk <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
      </a>
    </div>

    <!-- Product Grid (Responsive Flexbox / Grid) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% if (featuredProducts && featuredProducts.length > 0) { %>
        <% featuredProducts.forEach(p => { %>
          <article class="glass-card rounded-2xl overflow-hidden hover:border-emerald-500/40 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="relative aspect-video bg-slate-800 overflow-hidden">
                <img src="<%= p.image %>" alt="<%= p.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                <span class="absolute top-2.5 left-2.5 px-2.5 py-1 rounded-full bg-slate-900/80 backdrop-blur-md text-[11px] font-medium text-emerald-300 border border-slate-700">
                  <%= p.category %>
                </span>
              </div>

              <div class="p-5 space-y-2">
                <h3 class="font-bold text-white text-base line-clamp-1 group-hover:text-emerald-400 transition-colors"><%= p.name %></h3>
                <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed"><%= p.description %></p>
              </div>
            </div>

            <div class="p-5 pt-0 space-y-3">
              <div class="flex items-baseline justify-between border-t border-slate-800 pt-3">
                <div>
                  <span class="text-xs text-slate-400 block">Harga</span>
                  <span class="font-extrabold text-emerald-400 text-base">Rp <%= p.price.toLocaleString('id-ID') %></span>
                </div>
                <div class="text-right">
                  <span class="text-xs text-slate-400 block">Stok</span>
                  <span class="text-xs font-semibold <%= p.stock > 10 ? 'text-slate-200' : 'text-amber-400' %>"><%= p.stock %> <%= p.unit %></span>
                </div>
              </div>

              <a href="/produk/<%= p.id %>" class="w-full py-2 rounded-xl bg-slate-800 hover:bg-emerald-600 hover:text-white border border-slate-700 text-slate-200 text-xs font-semibold transition-all flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-eye"></i> Detail Produk
              </a>
            </div>
          </article>
        <% }) %>
      <% } else { %>
        <div class="col-span-full py-12 text-center text-slate-400">
          Belum ada produk yang ditampilkan.
        </div>
      <% } %>
    </div>

  </div>
</section>

<!-- Feature Section -->
<section class="py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <div class="glass-card p-6 rounded-2xl space-y-3 border-l-4 border-l-emerald-500">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl">
          <i class="fa-solid fa-truck-ramp-box"></i>
        </div>
        <h3 class="font-bold text-white text-lg">Layanan Antar Cepat</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Pesan via WA atau setelah tanya bot, sembako diantar langsung sampai ke depan pintu rumah Anda.
        </p>
      </div>

      <div class="glass-card p-6 rounded-2xl space-y-3 border-l-4 border-l-teal-500">
        <div class="w-12 h-12 rounded-xl bg-teal-500/10 text-teal-400 flex items-center justify-center text-xl">
          <i class="fa-solid fa-tags"></i>
        </div>
        <h3 class="font-bold text-white text-lg">Harga Grosir Murah</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Harga bersaing langsung dari pemasok tangan pertama tanpa biaya tersembunyi.
        </p>
      </div>

      <div class="glass-card p-6 rounded-2xl space-y-3 border-l-4 border-l-emerald-400">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-300 flex items-center justify-center text-xl">
          <i class="fa-solid fa-headset"></i>
        </div>
        <h3 class="font-bold text-white text-lg">Fitur "Tanya AI" 24/7</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Butuh info cepat jam buka, stok beras 5kg, atau biaya ongkir? Tanyakan langsung ke fitur Tanya AI!
        </p>
      </div>

    </div>
  </div>
</section>

<%- include('partials/footer') %>
