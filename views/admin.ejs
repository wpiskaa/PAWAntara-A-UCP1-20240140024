<%- include('partials/navbar') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
  
  <!-- Dashboard Header -->
  <div class="glass-card p-6 rounded-3xl border border-slate-700/80 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-semibold border border-emerald-500/30">
          <i class="fa-solid fa-user-shield text-[10px]"></i> Logged in as <%= user.username %>
        </span>
        <span class="text-xs text-slate-500">UMKM Sembako Management</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Dashboard Kelola Produk & Stok</h1>
      <p class="text-xs text-slate-400">Tambah, edit harga, perbarui jumlah stok, atau hapus produk sembako secara real-time.</p>
    </div>

    <div class="flex items-center gap-3">
      <button 
        id="add-product-btn" 
        type="button" 
        class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-bold text-xs shadow-lg shadow-emerald-600/20 transition-all flex items-center gap-2"
      >
        <i class="fa-solid fa-plus"></i> Tambah Produk Baru
      </button>

      <button 
        id="logout-btn" 
        type="button" 
        class="px-4 py-2.5 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 font-semibold text-xs transition-colors flex items-center gap-1.5"
      >
        <i class="fa-solid fa-right-from-bracket"></i> Logout
      </button>
    </div>
  </div>

  <!-- Product Table Section -->
  <section class="glass-card rounded-2xl overflow-hidden shadow-xl border border-slate-800">
    <div class="p-4 bg-slate-900 border-b border-slate-800 flex items-center justify-between">
      <h2 class="font-bold text-white text-sm flex items-center gap-2">
        <i class="fa-solid fa-boxes-stacked text-emerald-400"></i> Data Katalog Sembako (<%= products.length %> item)
      </h2>
      <span class="text-xs text-slate-400">Data tersimpan di SQLite Database</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950 text-slate-400 uppercase tracking-wider font-semibold border-b border-slate-800">
          <tr>
            <th scope="col" class="px-4 py-3">ID</th>
            <th scope="col" class="px-4 py-3">Produk</th>
            <th scope="col" class="px-4 py-3">Kategori</th>
            <th scope="col" class="px-4 py-3">Harga</th>
            <th scope="col" class="px-4 py-3">Stok</th>
            <th scope="col" class="px-4 py-3 text-right">Aksi Management</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 bg-slate-900/40">
          <% if (products && products.length > 0) { %>
            <% products.forEach(p => { %>
              <tr id="prod-row-<%= p.id %>" class="hover:bg-slate-800/40 transition-colors">
                <td class="px-4 py-3.5 font-mono text-slate-500">#<%= p.id %></td>
                <td class="px-4 py-3.5">
                  <div class="flex items-center gap-3">
                    <img src="<%= p.image %>" alt="<%= p.name %>" class="w-10 h-10 rounded-lg object-cover bg-slate-800 flex-shrink-0">
                    <div>
                      <span class="font-bold text-white text-sm block leading-tight"><%= p.name %></span>
                      <span class="text-[11px] text-slate-500 line-clamp-1"><%= p.description %></span>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3.5">
                  <span class="px-2.5 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700 text-[11px] font-medium">
                    <%= p.category %>
                  </span>
                </td>
                <td class="px-4 py-3.5">
                  <span class="font-extrabold text-emerald-400 text-sm">Rp <%= p.price.toLocaleString('id-ID') %></span>
                  <span class="text-[10px] text-slate-500 block">/ <%= p.unit %></span>
                </td>
                <td class="px-4 py-3.5">
                  <span class="px-2 py-0.5 rounded font-bold text-xs <%= p.stock > 10 ? 'bg-emerald-500/10 text-emerald-400' : p.stock > 0 ? 'bg-amber-500/10 text-amber-400' : 'bg-red-500/10 text-red-400' %>">
                    <%= p.stock %> <%= p.unit %>
                  </span>
                </td>
                <td class="px-4 py-3.5 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <button 
                      type="button" 
                      class="edit-btn px-3 py-1.5 rounded-lg bg-emerald-600/20 hover:bg-emerald-600 text-emerald-400 hover:text-white border border-emerald-500/30 text-xs font-semibold transition-colors flex items-center gap-1"
                      data-id="<%= p.id %>"
                      data-name="<%= p.name %>"
                      data-category="<%= p.category %>"
                      data-price="<%= p.price %>"
                      data-stock="<%= p.stock %>"
                      data-unit="<%= p.unit %>"
                      data-image="<%= p.image %>"
                      data-description="<%= p.description %>"
                    >
                      <i class="fa-solid fa-pen-to-square"></i> Edit
                    </button>
                    
                    <button 
                      type="button" 
                      class="delete-btn px-3 py-1.5 rounded-lg bg-red-500/10 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/30 text-xs font-semibold transition-colors flex items-center gap-1"
                      data-id="<%= p.id %>"
                      data-name="<%= p.name %>"
                    >
                      <i class="fa-solid fa-trash-can"></i> Hapus
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="px-4 py-8 text-center text-slate-400">
                Belum ada produk. Klik tombol "Tambah Produk Baru" untuk menambahkan produk.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

</div>

<!-- Modal Form Create / Edit Product -->
<div id="product-modal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="glass-card w-full max-w-xl rounded-3xl shadow-2xl border border-slate-700 overflow-hidden fade-in">
    
    <div class="p-5 bg-slate-900 border-b border-slate-800 flex items-center justify-between">
      <h3 id="modal-title" class="font-bold text-white text-base flex items-center gap-2">
        <i class="fa-solid fa-box text-emerald-400"></i> Form Produk Sembako
      </h3>
      <button id="cancel-modal-btn" type="button" class="text-slate-400 hover:text-white p-1">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form id="product-form" class="p-6 space-y-4">
      <input type="hidden" id="prod-id" name="id">

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5 sm:col-span-2">
          <label for="prod-name" class="block text-xs font-semibold text-slate-300">Nama Produk *</label>
          <input type="text" id="prod-name" required placeholder="Contoh: Beras Premium Raja Udang 5kg" class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:ring-2 focus:ring-emerald-500">
        </div>

        <div class="space-y-1.5">
          <label for="prod-category" class="block text-xs font-semibold text-slate-300">Kategori *</label>
          <input type="text" id="prod-category" required placeholder="Beras / Minyak / Gula / dll" class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:ring-2 focus:ring-emerald-500">
        </div>

        <div class="space-y-1.5">
          <label for="prod-unit" class="block text-xs font-semibold text-slate-300">Satuan</label>
          <input type="text" id="prod-unit" placeholder="Pouch 2L / Karung 5kg / Kg" class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:ring-2 focus:ring-emerald-500">
        </div>

        <div class="space-y-1.5">
          <label for="prod-price" class="block text-xs font-semibold text-slate-300">Harga (Rp) *</label>
          <input type="number" id="prod-price" required min="0" placeholder="72000" class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:ring-2 focus:ring-emerald-500">
        </div>

        <div class="space-y-1.5">
          <label for="prod-stock" class="block text-xs font-semibold text-slate-300">Jumlah Stok *</label>
          <input type="number" id="prod-stock" required min="0" placeholder="25" class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:ring-2 focus:ring-emerald-500">
        </div>

        <div class="space-y-1.5 sm:col-span-2">
          <label for="prod-image" class="block text-xs font-semibold text-slate-300">URL Gambar (Image Link)</label>
          <input type="url" id="prod-image" placeholder="https://images.unsplash.com/..." class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:ring-2 focus:ring-emerald-500">
        </div>

        <div class="space-y-1.5 sm:col-span-2">
          <label for="prod-desc" class="block text-xs font-semibold text-slate-300">Deskripsi Produk</label>
          <textarea id="prod-desc" rows="3" placeholder="Tuliskan keterangan detail mengenai kualitas sembako..." class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:ring-2 focus:ring-emerald-500"></textarea>
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
        <button type="button" onclick="document.getElementById('product-modal').classList.add('hidden')" class="px-4 py-2 rounded-xl bg-slate-800 text-slate-300 text-xs font-semibold hover:bg-slate-700">
          Batal
        </button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold shadow-md shadow-emerald-600/20">
          Simpan Produk
        </button>
      </div>
    </form>

  </div>
</div>

<!-- Include Admin Dashboard JS -->
<script src="/js/admin.js"></script>

<%- include('partials/footer') %>
