<%- include('partials/navbar') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
  
  <!-- Page Header -->
  <div class="space-y-2">
    <div class="flex items-center gap-2 text-xs text-emerald-400 font-semibold uppercase tracking-wider">
      <a href="/" class="hover:underline">Beranda</a> <i class="fa-solid fa-chevron-right text-[9px] text-slate-600"></i> Katalog Produk
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Daftar Sembako & Kebutuhan Rumah Tangga</h1>
    <p class="text-slate-400 text-sm">Temukan beras, minyak, gula, telur, dan bumbu dapur lengkap dengan stok ter-update.</p>
  </div>

  <!-- Filter & Search Form (Server-Processed req.query - Semantic Aside) -->
  <aside class="glass-card p-4 sm:p-6 rounded-2xl" aria-label="Pencarian dan Filter Produk">
    <form action="/produk" method="GET" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
      
      <!-- Input Search -->
      <div class="md:col-span-6 space-y-1.5">
        <label for="search-input" class="block text-xs font-semibold text-slate-300">
          <i class="fa-solid fa-magnifying-glass mr-1 text-emerald-400"></i> Cari Nama Produk / Deskripsi
        </label>
        <input 
          type="text" 
          id="search-input" 
          name="search" 
          value="<%= searchQuery %>" 
          placeholder="Misal: Beras 5kg, Minyak Bimoli, Gula..."
          class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all"
        >
      </div>

      <!-- Select Kategori -->
      <div class="md:col-span-4 space-y-1.5">
        <label for="kategori-select" class="block text-xs font-semibold text-slate-300">
          <i class="fa-solid fa-filter mr-1 text-teal-400"></i> Kategori Sembako
        </label>
        <select 
          id="kategori-select" 
          name="kategori"
          class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all"
        >
          <option value="">Semua Kategori</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>

      <!-- Submit & Reset Buttons -->
      <div class="md:col-span-2 flex items-center gap-2">
        <button type="submit" class="flex-1 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm transition-all shadow-md shadow-emerald-600/20 flex items-center justify-center gap-1.5">
          <i class="fa-solid fa-search"></i> Cari
        </button>
        <% if (searchQuery || selectedCategory) { %>
          <a href="/produk" class="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-sm transition-all" title="Reset Filter">
            <i class="fa-solid fa-rotate-left"></i>
          </a>
        <% } %>
      </div>

    </form>
  </aside>

  <!-- Products List Grid -->
  <section class="space-y-6">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold text-slate-400">
        Menampilkan <span class="text-emerald-400 font-bold"><%= products.length %></span> produk sembako
      </span>
      <% if (searchQuery || selectedCategory) { %>
        <span class="text-xs text-slate-400">
          Filter aktif: <% if (searchQuery) { %>Kata kunci "<strong class="text-white"><%= searchQuery %></strong>" <% } %> <% if (selectedCategory) { %>Kategori "<strong class="text-white"><%= selectedCategory %></strong>"<% } %>
        </span>
      <% } %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <% if (products && products.length > 0) { %>
        <% products.forEach(p => { %>
          <article class="glass-card rounded-2xl overflow-hidden hover:border-emerald-500/40 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="relative aspect-video bg-slate-800 overflow-hidden">
                <img src="<%= p.image %>" alt="<%= p.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                <span class="absolute top-2.5 left-2.5 px-2.5 py-1 rounded-full bg-slate-900/80 backdrop-blur-md text-[11px] font-medium text-emerald-300 border border-slate-700">
                  <%= p.category %>
                </span>
                <% if (p.stock <= 5) { %>
                  <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded bg-amber-500/90 text-slate-950 font-bold text-[10px]">Stok Menipis</span>
                <% } %>
              </div>

              <div class="p-5 space-y-2">
                <h3 class="font-bold text-white text-base line-clamp-1 group-hover:text-emerald-400 transition-colors"><%= p.name %></h3>
                <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed"><%= p.description %></p>
              </div>
            </div>

            <div class="p-5 pt-0 space-y-3">
              <div class="flex items-baseline justify-between border-t border-slate-800 pt-3">
                <div>
                  <span class="text-[11px] text-slate-400 block">Harga / Satuan</span>
                  <span class="font-extrabold text-emerald-400 text-base">Rp <%= p.price.toLocaleString('id-ID') %></span>
                  <span class="text-[10px] text-slate-500 block">/ <%= p.unit %></span>
                </div>
                <div class="text-right">
                  <span class="text-[11px] text-slate-400 block">Status Stok</span>
                  <span class="text-xs font-bold <%= p.stock > 10 ? 'text-emerald-400' : p.stock > 0 ? 'text-amber-400' : 'text-red-400' %>">
                    <%= p.stock > 0 ? p.stock + ' ' + p.unit : 'Habis' %>
                  </span>
                </div>
              </div>

              <a href="/produk/<%= p.id %>" class="w-full py-2 rounded-xl bg-slate-800 hover:bg-emerald-600 hover:text-white border border-slate-700 text-slate-200 text-xs font-semibold transition-all flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-eye"></i> Detail Produk
              </a>
            </div>
          </article>
        <% }) %>
      <% } else { %>
        <div class="col-span-full py-16 text-center glass-card rounded-2xl space-y-3">
          <div class="w-12 h-12 rounded-full bg-slate-800 text-slate-500 flex items-center justify-center mx-auto text-xl">
            <i class="fa-solid fa-box-open"></i>
          </div>
          <p class="text-slate-300 font-semibold">Produk Tidak Ditemukan</p>
          <p class="text-xs text-slate-500 max-w-sm mx-auto">Tidak ada produk sembako yang sesuai dengan kata kunci pencarian atau kategori yang Anda pilih.</p>
          <a href="/produk" class="inline-block px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-semibold hover:bg-emerald-500">
            Tampilkan Semua Produk
          </a>
        </div>
      <% } %>
    </div>
  </section>

</div>

<%- include('partials/footer') %>
